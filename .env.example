GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=llama-3.3-70b-versatile
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_MAX_CONCURRENCY=2

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION=pkc_tech

EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
TOP_K=8
USE_HYBRID=true
RRF_K=60

INJECTION_THRESHOLD=0.8
OUT_OF_SCOPE_THRESHOLD=0.6
FAITHFULNESS_THRESHOLD=0.7
ENABLE_GROUNDEDNESS_CHECK=true
GUARDRAILS_FAIL_CLOSED=true

JWT_SECRET=change-this-to-any-random-text-later
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=pkc-secure-knowledge
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

LEDGER_DB_PATH=data/ledger.db
DAILY_TOKEN_BUDGET=50000
DAILY_SHADOW_COST_ALERT_USD=5.0
